{
  "name": "jimeng-free-api",
  "version": "1.2.8",
  "description": "\ud83d\ude80 \u514d\u8d39\u7684\u9ad8\u7ea7\u5373\u68a6(Jimeng) AI \u63a5\u53e3\u670d\u52a1\uff0c\u652f\u6301 4.x/3.x \u56fe\u50cf\u6a21\u578b\u548c\u89c6\u9891\u751f\u6210\uff0cOpenAI \u517c\u5bb9\uff0c\u5185\u7f6e\u53ef\u89c6\u5316\u7ba1\u7406\u63a7\u5236\u53f0\u3002",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "directories": {
    "dist": "dist"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "npm run build:css && tsup src/index.ts --format cjs,esm --sourcemap --dts --publicDir public --external playwright-core --watch --onSuccess \"node --enable-source-maps --no-node-snapshot dist/index.js\"",
    "start": "node --enable-source-maps --no-node-snapshot dist/index.js",
    "build": "npm run build:css && tsup src/index.ts --format cjs,esm --sourcemap --dts --clean --publicDir public --external playwright-core",
    "build:css": "tailwindcss -i src/usage.css -o public/usage.css --minify",
    "test:usage": "tsup tests/usage.test.ts --format esm --out-dir .test-build --external better-sqlite3 && node --test .test-build/usage.test.js",
    "test:usage:http": "npm run build && python3 tests/usage-http.py"
  },
  "author": "Vinlic",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "better-sqlite3": "^13.0.3",
    "colors": "^1.4.0",
    "crc-32": "^1.2.2",
    "cron": "^3.1.6",
    "date-fns": "^3.3.1",
    "eventsource-parser": "^1.1.2",
    "form-data": "^4.0.0",
    "fs-extra": "^11.2.0",
    "koa": "^2.15.0",
    "koa-body": "^5.0.0",
    "koa-bodyparser": "^4.4.1",
    "koa-range": "^0.3.0",
    "koa-router": "^12.0.1",
    "koa2-cors": "^2.0.6",
    "lodash": "^4.17.21",
    "mime": "^4.0.1",
    "minimist": "^1.2.8",
    "randomstring": "^1.3.0",
    "uuid": "^9.0.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/koa": "^3.0.3",
    "@types/lodash": "^4.14.202",
    "@types/mime": "^3.0.4",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "playwright-core": "^1.63.0"
  }
}
